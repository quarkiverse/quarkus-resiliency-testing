<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.resiliencytesting</groupId>
        <artifactId>quarkus-resiliency-testing-cxf-client-parent</artifactId>
        <version>0.5.0</version>
    </parent>
    <artifactId>quarkus-resiliency-testing-cxf-client</artifactId>
    <name>Quarkus Resiliency Testing - CXF Client - Runtime</name>
    <description>Network fault targets for CXF</description>

    <properties>
        <!-- the Quarkus extension whose presence brings this module into a build -->
        <resiliency-testing.requires>io.quarkiverse.cxf:quarkus-cxf</resiliency-testing.requires>
        <automatic.module.name>io.quarkiverse.resiliencytesting.cxf</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.resiliencytesting</groupId>
            <artifactId>quarkus-resiliency-testing-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.cxf</groupId>
            <artifactId>quarkus-cxf</artifactId>
            <version>${quarkus-cxf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
