METHOD writeBytes
AT ENTRY
IF $0.path != null && (new java.io.File($0.path)).toPath().toAbsolutePath().normalize().startsWith("{directory}")
DO java.lang.System.setProperty("{hit}", "true");
   throw new java.io.IOException("No space left on device")
ENDRULE
{#include hide-frames of="RandomAccessFile.writeBytes" type="java.io.RandomAccessFile" method="writeBytes" /}

# every write of a FileChannel, and with it Files.write, Files.newOutputStream and Files.newBufferedWriter
RULE {fault} FileChannel.write
CLASS sun.nio.ch.FileChannelImpl
METHOD write
AT ENTRY
IF $0.path != null && (new java.io.File($0.path)).toPath().toAbsolutePath().normalize().startsWith("{directory}")
DO java.lang.System.setProperty("{hit}", "true");
   throw new java.io.IOException("No space left on device")
ENDRULE
{#include hide-frames of="FileChannel.write" type="sun.nio.ch.FileChannelImpl" method="write" /}

RULE {fault} FileChannel.transferFrom
CLASS sun.nio.ch.FileChannelImpl
METHOD transferFrom
AT ENTRY
IF $0.path != null && (new java.io.File($0.path)).toPath().toAbsolutePath().normalize().startsWith("{directory}")
DO java.lang.System.setProperty("{hit}", "true");
   throw new java.io.IOException("No space left on device")
ENDRULE
{#include hide-frames of="FileChannel.transferFrom" type="sun.nio.ch.FileChannelImpl" method="transferFrom" /}

# copies a file in native code, without a channel; $2 is the file copied to
RULE {fault} Files.copy
CLASS java.nio.file.Files
METHOD copy(java.nio.file.Path, java.nio.file.Path, java.nio.file.CopyOption[])
AT ENTRY
IF $2.toAbsolutePath().normalize().startsWith("{directory}")
DO java.lang.System.setProperty("{hit}", "true");
   throw new java.nio.file.FileSystemException($2.toString(), null, "No space left on device")
ENDRULE
{#include hide-frames of="Files.copy" type="java.nio.file.Files" method="copy(java.nio.file.Path, java.nio.file.Path, java.nio.file.CopyOption[])" /}
